rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isFriend(uidA, uidB) {
      return exists(/databases/$(database)/documents/users/$(uidA))
        && uidB in get(/databases/$(database)/documents/users/$(uidA)).data.friends;
    }

    function acceptedInvitePath(inviteId, userId) {
      let inviteAfter = getAfter(/databases/$(database)/documents/friendInvites/$(inviteId));
      let actorUid = request.auth.uid;
      let actorAfter = getAfter(/databases/$(database)/documents/users/$(actorUid));
      return inviteAfter.data.status == 'accepted'
        && inviteAfter.data.toUserId == actorUid
        && (
          (inviteAfter.data.fromUserId == userId && actorUid in request.resource.data.friends && userId in actorAfter.data.friends)
          ||
          (inviteAfter.data.toUserId == userId && inviteAfter.data.fromUserId in request.resource.data.friends)
        );
    }

    function canWriteFriendsOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'friends',
        'updatedAt',
        'lastAcceptedFriendInviteId'
      ]);
    }

    function canAcceptFriendInviteUserWrite(userId) {
      return isSignedIn()
        && request.resource.data.lastAcceptedFriendInviteId is string
        && canWriteFriendsOnlyFields()
        && acceptedInvitePath(request.resource.data.lastAcceptedFriendInviteId, userId);
    }

    function canCreatePartyInvite() {
      let partyId = request.resource.data.partyId;
      let partyPath = /databases/$(database)/documents/parties/$(partyId);
      return isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.inviteeId is string
        && exists(partyPath)
        && (
          get(partyPath).data.hostId == request.auth.uid
          || request.auth.uid in get(partyPath).data.memberIds
        );
    }

    // UI action: Add friend (send friend invite from social panel).
    match /friendInvites/{inviteId} {
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';

      // UI action: Add friend (invite inbox read for pending friend requests).
      allow get, list: if isSignedIn()
        && (
          resource.data.toUserId == request.auth.uid
          || resource.data.fromUserId == request.auth.uid
        );

      // UI action: Accept invite (only recipient can respond).
      allow update: if isSignedIn()
        && resource.data.toUserId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.status in ['accepted', 'declined']
        && (
          request.resource.data.status == 'declined'
          || (
            request.resource.data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/users/$(resource.data.fromUserId)).data.friends.hasAll([resource.data.toUserId])
            && getAfter(/databases/$(database)/documents/users/$(resource.data.toUserId)).data.friends.hasAll([resource.data.fromUserId])
          )
        );

      allow delete: if false;
    }

    // UI action: Invite friend to lobby (party invite create from social panel).
    match /partyInvites/{inviteId} {
      allow create: if canCreatePartyInvite()
        && request.resource.data.toUserId == request.resource.data.inviteeId;

      // UI action: Invite friend to lobby (recipient inbox read).
      allow get, list: if isSignedIn()
        && (
          resource.data.inviteeId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || resource.data.fromUserId == request.auth.uid
        );

      // UI action: Invite friend to lobby (only recipient can accept/decline).
      allow update: if isSignedIn()
        && (
          resource.data.inviteeId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
        )
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }



    function partyDocPath(partyId) {
      return /databases/$(database)/documents/parties/$(partyId);
    }

    function partyMemberDocPath(partyId, uid) {
      return /databases/$(database)/documents/parties/$(partyId)/partyMembers/$(uid);
    }

    function canReadParty(partyId) {
      let partyData = get(partyDocPath(partyId)).data;
      let partyMemberIds = partyData.memberIds is list ? partyData.memberIds : [];
      return isSignedIn()
        && (
          exists(partyMemberDocPath(partyId, request.auth.uid))
          || request.auth.uid in partyMemberIds
          || partyData.hostId == request.auth.uid
          || partyData.status == 'open'
        );
    }

    function isValidJoinPartyMemberCreate(partyId, uid) {
      return isCurrentUser(uid)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'photoURL',
          'joinedAt',
          'updatedAt',
          'isHost'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.isHost == false
        && get(partyDocPath(partyId)).data.status == 'open'
        && getAfter(partyDocPath(partyId)).data.memberIds.hasAll([uid])
        && getAfter(partyDocPath(partyId)).data.playerIds.hasAll([uid]);
    }

    function isValidJoinPartyMemberUpdate(uid) {
      return isCurrentUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.isHost == resource.data.isHost
        && request.resource.data.joinedAt == resource.data.joinedAt;
    }

    function isValidJoinPartyAggregateUpdate(partyId) {
      let uid = request.auth.uid;
      let beforeMemberIds = resource.data.memberIds is list ? resource.data.memberIds : [];
      let afterMemberIds = request.resource.data.memberIds;
      let alreadyMember = beforeMemberIds.hasAny([uid]);
      let addsOnlySelf = !alreadyMember
        && afterMemberIds.size() == beforeMemberIds.size() + 1
        && afterMemberIds.hasAll(beforeMemberIds)
        && afterMemberIds.hasAll([uid]);
      let unchangedMembers = alreadyMember && afterMemberIds == beforeMemberIds;
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds',
          'playerIds',
          'playerNames',
          'playerCount',
          'players',
          'assignedGlyphs',
          'availableGlyphs',
          'updatedAt'
        ])
        && resource.data.status == 'open'
        && request.resource.data.status == resource.data.status
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.hostDisplayName == resource.data.hostDisplayName
        && afterMemberIds is list
        && request.resource.data.playerIds is list
        && request.resource.data.playerNames is list
        && request.resource.data.playerIds == afterMemberIds
        && request.resource.data.playerNames.size() == afterMemberIds.size()
        && request.resource.data.playerCount == afterMemberIds.size()
        && request.resource.data.players == afterMemberIds.size()
        && afterMemberIds.size() <= 8
        && (addsOnlySelf || unchangedMembers)
        && getAfter(partyMemberDocPath(partyId, uid)).data.isHost == false;
    }


    // UI actions: Create/read/update lobby and roster membership.
    match /parties/{partyId} {
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAll([request.auth.uid]);

      allow get: if canReadParty(partyId);
      allow list: if false;

      // Join flow aggregate update: partyMembers/{uid} + parties/{partyId} in one transaction.
      allow update: if isValidJoinPartyAggregateUpdate(partyId);

      allow delete: if false;

      match /partyMembers/{uid} {
        allow get: if isCurrentUser(uid) || canReadParty(partyId);
        allow list: if canReadParty(partyId);

        allow create: if isValidJoinPartyMemberCreate(partyId, uid);
        allow update: if isValidJoinPartyMemberUpdate(uid);

        allow delete: if false;
      }
    }

    // UI actions: Add friend + accept invite + social panel friends presence.
    match /users/{userId} {
      // Read own profile and friends data needed by inbox/social UI.
      allow get: if isCurrentUser(userId)
        || (isSignedIn() && isFriend(userId, request.auth.uid));

      allow list: if false;

      // Self profile maintenance updates (cannot arbitrarily rewrite friends array).
      allow create: if isCurrentUser(userId);

      allow update: if isCurrentUser(userId)
        ? request.resource.data.friends == resource.data.friends
        : canAcceptFriendInviteUserWrite(userId);

      // Preserve user documents from client-side deletion.
      allow delete: if false;
    }

    // UI action: Resolve friend invite target via deterministic identifier lookup docs.
    match /userIdentifiers/{identifierId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['uid', 'name', 'email'];

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['uid', 'name', 'email'];

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
